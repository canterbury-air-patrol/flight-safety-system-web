# Copy this file to .env and fill in real values before running docker-compose.
# .env is gitignored — never commit it.

DB_USER=postgres
DB_NAME=fss
DB_PASS=<strong-random-password>

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<output-of-above-command>

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=<strong-random-password>
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Comma-separated list of hostnames this instance is reachable on.
ALLOWED_HOSTS=localhost

# Comma-separated https:// origins. Required if accessed over HTTPS.
CSRF_TRUSTED_ORIGINS=

# Comma-separated peer FSS server origins for multi-server deployments.
# Each of these is automatically also trusted for CSRF, so peers only need to
# be listed here, not duplicated in CSRF_TRUSTED_ORIGINS above.
CORS_ALLOWED_ORIGINS=

# Keep these enabled for every HTTPS deployment. Set both to false only when
# evaluating or developing locally over http://localhost:8090.
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# HSTS: set to seconds to enable (e.g. 31536000 for 1 year in production).
# Requires a reverse proxy that sets X-Forwarded-Proto: https and strips any
# client-supplied X-Forwarded-Proto header. Leave at 0 without a trusted proxy.
SECURE_HSTS_SECONDS=0
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=false

# The optional production TLS proxy mounts these operator-provided files.
# Keep private keys outside version control.
TLS_CERTIFICATE_PATH=./certs/fullchain.pem
TLS_PRIVATE_KEY_PATH=./certs/privkey.pem

# Optional telemetry age limits in days. Empty values disable pruning for that
# table. Deletion is irreversible; review the README and run a dry run before
# setting any limit.
TELEMETRY_POSITION_RETENTION_DAYS=
TELEMETRY_STATUS_RETENTION_DAYS=
TELEMETRY_RTT_RETENTION_DAYS=
TELEMETRY_SEARCH_PROGRESS_RETENTION_DAYS=

# Preserve this many hours of the newest shared per-asset telemetry timeline
# across every table, even where a table's age limit is shorter. Set to 0 to
# disable this safeguard.
TELEMETRY_ALIGNED_WINDOW_HOURS=24

# Optional age limit in days for older command audit units. Each eligible
# command and all of its acknowledgement rows are deleted together. The newest
# command for every asset is always preserved. Empty disables this cleanup.
COMMAND_AUDIT_RETENTION_DAYS=
